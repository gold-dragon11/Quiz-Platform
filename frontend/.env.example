# Base URL of the backend API (must be prefixed VITE_ to be exposed to the client)
VITE_API_URL=http://localhost:3000/api/v1

# Where browser errors are reported (Sentry). Leave empty locally and in CI:
# with no DSN the SDK is inert and nothing leaves the browser. Vite inlines
# this at build time, so changing it needs a rebuild, not a restart.
VITE_SENTRY_DSN=
