// Prisma schema for the Quiz Platform — MVP database layer.
//
// This schema is a direct transcription of the documentation in docs/02-domain
// and docs/03-database. Table names follow the snake_case plural convention
// from docs/03-database/tables.md §5; column names remain camelCase to match
// the way columns are referenced throughout docs/03-database/indexes.md.
//
// Enums intentionally contain only MVP values; future-scope values noted in the
// documentation (e.g. Theme.Light, QuizStatus.Abandoned) are deferred.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

/// User account lifecycle status (docs/02-domain/user.md §5).
enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

/// Role-based authorization (docs/01-prd/authentication.md §11,
/// docs/06-backend/security.md §6). Stored on User.role.
///
/// TEACHER is a separate account type chosen at registration, not a flag on a
/// student account: every screen then knows without asking which product it is
/// showing. It shares nothing with ADMIN — a teacher never edits the question
/// bank (docs/00-overview/teacher-side-decisions.md decision 17).
enum UserRole {
  USER
  TEACHER
  ADMIN
}

/// Subscription plan, priced by how many students the teacher works with
/// (decision 19). Steps rather than per-student billing: a teacher knows the
/// amount in advance, and unpredictability unsettles people more than price.
enum SubscriptionTier {
  TIER_10
  TIER_30
  UNLIMITED
}

/// Subscription lifecycle. The trial runs without a card until the teacher
/// adds a fourth student, so the product is judged on a real group.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Which attempt counts when an assignment allows more than one (decision 10).
/// The teacher chooses per assignment: homework is control by default, but a
/// topic being drilled deserves a retake.
enum ScoredAttempt {
  FIRST
  LAST
  BEST
}

/// When a student may see the explanation for an assignment question
/// (decision 10). Withholding it until the deadline is what makes an
/// assignment usable as control rather than as practice.
enum ExplanationVisibility {
  IMMEDIATE
  AFTER_SUBMIT
  AFTER_DUE
}

/// Supported languages — used both for UserSettings.language and as the locale
/// key on translation tables (docs/02-domain/user-settings.md §5,
/// docs/01-prd/localization.md).
enum Language {
  ENGLISH
  UKRAINIAN
}

/// Visual theme (docs/02-domain/user-settings.md §9). MVP ships Dark only;
/// Light / System are future.
enum Theme {
  DARK
}

/// Avatar source (docs/02-domain/avatar.md §5). Future: AI / Animated / Seasonal.
enum AvatarType {
  PREDEFINED
  CUSTOM_UPLOAD
}

/// Question format (docs/02-domain/question.md §5). Future: Multiple Choice,
/// Ordering, Fill in the Blank, Numeric, Drag & Drop, Image Selection.
enum QuestionType {
  SINGLE_CHOICE
  MATCHING
  /// Put the items in the right order. The stored `order` of the options is
  /// the key, so the delivery view deals them shuffled.
  ORDERING
  /// Several statements, of which a fixed number are correct — the exam asks
  /// for three out of seven.
  MULTIPLE_CHOICE
  /// Write the number you worked out. No options at all: the expected value
  /// lives in `configuration.answer`, so it never reaches the client.
  NUMERIC
}

/// Which specification a question was written to.
///
/// `PRACTICE` is the original bank: useful for drilling a topic, but not
/// built to the exam's shape — four options where the paper gives five,
/// matching tasks with no spare choices.
///
/// `NMT` is written to the current specification and is what a mock exam may
/// draw from. The two live side by side on purpose: a practice question is
/// still a good question to train on, it just must not turn up in a sitting
/// that claims to be like the real thing.
enum QuestionFormat {
  PRACTICE
  NMT
}

/// Optional question difficulty tag (docs/02-domain/question.md §4).
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Quiz generation mode — used by Quiz.mode and QuizSession.mode
/// (docs/02-domain/quiz.md §5). Future: Daily Challenge, Mock Exam, Practice,
/// Custom.
enum QuizType {
  SUBJECT_QUIZ
  RANDOM_QUIZ
  /// One player's half of a duel (decision 21). A session rather than its own
  /// entity so scoring, exposure history, XP and statistics stay single
  /// implementations — a parallel engine for duels would drift from the real
  /// one within a month.
  DUEL
  /// A full mock sitting of the national exam, timed as a whole rather than
  /// per question (docs/00-overview/teacher-side-decisions.md decision 28).
  /// Its own type rather than a preset so that "how did my mock exams go" is
  /// a query, not an archaeology exercise over ordinary practice.
  MOCK_EXAM
}

/// Quiz session lifecycle status (docs/02-domain/quiz-session.md §6). Abandoned
/// is future and deferred.
enum QuizStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

/// Source of an XP award (docs/02-domain/xp-transaction.md §5). Future: Daily
/// Challenge, Learning Streak, Achievements, Special Events, AI Challenges.
enum XPSource {
  QUIZ_COMPLETION
  HIGH_ACCURACY_BONUS
}

// ============================================================================
// Identity
// ============================================================================

/// docs/02-domain/user.md
model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  passwordHash  String
  emailVerified Boolean       @default(false)
  accountStatus AccountStatus @default(PENDING_VERIFICATION)
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime?

  profile        Profile?
  settings       UserSettings?
  avatar         Avatar?
  statistics     Statistics?
  quizSessions   QuizSession[]
  xpTransactions XPTransaction[]
  refreshTokens  RefreshToken[]

  ownedGroups        Group[]
  groupMemberships   GroupMembership[]
  createdAssignments Assignment[]
  assignmentTargets  AssignmentTarget[]
  questionExposures  QuestionExposure[]
  questionReports    QuestionReport[]   @relation("ReportAuthor")
  reportsResolved    QuestionReport[]   @relation("ReportResolver")
  subscription       Subscription?
  usageSnapshots     UsageSnapshot[]
  mistakeReviews     MistakeReview[]
  emailDispatches    EmailDispatch[]
  duelsChallenged    Duel[]             @relation("DuelChallenger")
  duelsReceived      Duel[]             @relation("DuelOpponent")

  @@map("users")
}

/// Persisted refresh-token sessions (docs/06-backend/security.md §5,
/// docs/06-backend/authentication.md §11). Stores only the Argon2 hash of the
/// token — the plaintext refresh token never touches the database. The row id
/// doubles as the token's `jti` claim, giving O(1) lookup on refresh.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// docs/02-domain/profile.md
model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String
  username    String   @unique
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// docs/02-domain/avatar.md
model Avatar {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  imageUrl  String
  type      AvatarType @default(PREDEFINED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

/// docs/02-domain/user-settings.md
model UserSettings {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @db.Uuid
  language                 Language @default(UKRAINIAN)
  theme                    Theme    @default(DARK)
  publicProfileEnabled     Boolean  @default(true)
  /// Email about new homework and approaching deadlines
  /// (docs/00-overview/teacher-side-decisions.md decision 25). On by default:
  /// a deadline nobody is told about is a deadline that gets missed, and the
  /// learner who does not want the mail is one switch away from silence.
  assignmentEmailsEnabled  Boolean  @default(true)
  /// Whether tutors of the learner's groups see a summary of their own,
  /// unassigned practice (decisions 04 and 16).
  ///
  /// On by default, and the disclosure that makes that acceptable happens when
  /// the learner joins a group — the point at which it starts to mean
  /// anything. Off by default would make the feature dead: nobody opens
  /// settings to enable something they have never seen. On in silence would be
  /// a surprise, and the surprise is the problem, not the sharing.
  ///
  /// One switch for every group: a teenager who does not want to share does
  /// not want to share with anybody, and a per-group screen is one they will
  /// never open.
  shareSelfStudyWithTutors Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// docs/02-domain/statistics.md — aggregated, rebuildable metrics.
/// The documented attribute table has no createdAt; only updatedAt is present.
model Statistics {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @db.Uuid
  totalQuizzes             Int      @default(0)
  totalQuestions           Int      @default(0)
  correctAnswers           Int      @default(0)
  incorrectAnswers         Int      @default(0)
  totalXP                  Int      @default(0)
  averageAccuracy          Decimal  @default(0) @db.Decimal(5, 2)
  totalLearningTimeSeconds Int      @default(0)
  currentStreak            Int      @default(0)
  longestStreak            Int      @default(0)
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("statistics")
}

// ============================================================================
// Learning content
// ============================================================================

/// docs/02-domain/subject.md
model Subject {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  description  String?
  icon         String?
  color        String?
  isPublished  Boolean   @default(false)
  displayOrder Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft delete (docs/03-database/tables.md §6): set instead of removing the
  /// row so historical Quiz Sessions stay valid. Slug and name stay reserved.
  deletedAt    DateTime?

  topics            Topic[]
  quizzes           Quiz[]
  quizSessions      QuizSession[]
  learningMaterials LearningMaterial[]
  translations      SubjectTranslation[]
  groups            Group[]
  duels             Duel[]
  resultPaperScores ResultPaperScore[]

  @@index([displayOrder])
  @@map("subjects")
}

/// Localized name/description for a Subject (docs/03-database/tables.md,
/// docs/03-database/indexes.md §4). One row per Subject per locale.
model SubjectTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   String   @db.Uuid
  locale      Language
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, locale])
  @@map("subject_translations")
}

/// docs/02-domain/topic.md
model Topic {
  id           String    @id @default(uuid()) @db.Uuid
  subjectId    String    @db.Uuid
  name         String
  slug         String
  description  String?
  displayOrder Int
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft delete (docs/03-database/tables.md §6): set instead of removing the
  /// row. Name and slug stay reserved within the subject.
  deletedAt    DateTime?

  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions         Question[]
  quizzes           Quiz[]
  quizSessions      QuizSession[]
  learningMaterials LearningMaterial[]
  translations      TopicTranslation[]
  duels             Duel[]
  passages          Passage[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([subjectId, displayOrder])
  @@map("topics")
}

/// Localized name/description for a Topic (docs/03-database/indexes.md §4).
model TopicTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  topicId     String   @db.Uuid
  locale      Language
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, locale])
  @@map("topic_translations")
}

/// docs/02-domain/question.md
model Question {
  id            String         @id @default(uuid()) @db.Uuid
  topicId       String         @db.Uuid
  type          QuestionType
  title         String
  explanation   String?
  imageUrl      String?
  difficulty    Difficulty?
  /// Type-specific correct-answer configuration
  /// (docs/02-domain/answer-option.md §9). For MATCHING it stores the correct
  /// pairs referencing option order values; SINGLE_CHOICE questions keep it
  /// null — their correctness lives on AnswerOption.isCorrect.
  configuration Json?
  /// Which specification this question follows — see QuestionFormat. Existing
  /// questions default to PRACTICE, so nothing has to be backfilled.
  format        QuestionFormat @default(PRACTICE)
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  /// Soft delete (docs/03-database/tables.md §6): set instead of removing the
  /// row so historical Quiz Sessions stay valid.
  deletedAt     DateTime?
  /// The text this question is asked about, when there is one — a story, a
  /// paragraph with numbered gaps, a set of short adverts
  /// (docs/02-domain/passage.md). Null for a question that stands alone.
  passageId     String?        @db.Uuid
  /// Position within the passage, from 1. For a text with numbered gaps it is
  /// the gap this question fills.
  passageOrder  Int?
  /// The number of the task on the NMT paper this question is written for —
  /// in mathematics, task 22 is the parameter problem
  /// (docs/02-domain/nmt-paper.md). For questions on a shared text, the first
  /// number of their block. Null outside the exam-format bank.
  nmtTask       Int?

  topic                Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  passage              Passage?              @relation(fields: [passageId], references: [id], onDelete: SetNull)
  answerOptions        AnswerOption[]
  attempts             QuestionAttempt[]
  translations         QuestionTranslation[]
  quizSessionQuestions QuizSessionQuestion[]
  assignmentQuestions  AssignmentQuestion[]
  duelQuestions        DuelQuestion[]
  exposures            QuestionExposure[]
  reports              QuestionReport[]
  mistakeReviews       MistakeReview[]

  @@index([topicId])
  @@index([type])
  @@index([topicId, type])
  @@index([passageId])
  @@index([nmtTask])
  @@map("questions")
}

/// A text several questions are asked about (docs/02-domain/passage.md).
///
/// The НМТ reads once and asks many times: five questions on one story, five
/// gaps in one paragraph, six descriptions matched against eight statements.
/// Kept apart from the question so the text is stored, shown and scrolled
/// once — not copied into the title of every question it serves.
model Passage {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @db.Uuid
  /// Stable identity within the topic, like a topic's own slug. Rewording the
  /// text keeps the key, so it stays the same passage — unlike a question,
  /// whose identity is its title and which a rewording turns into a new row.
  slug      String
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([topicId, slug])
  @@map("passages")
}

/// Localized title for a Question (docs/03-database/indexes.md §4).
model QuestionTranslation {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  locale     Language
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
  @@map("question_translations")
}

/// docs/02-domain/answer-option.md
model AnswerOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  content    String
  imageUrl   String?
  isCorrect  Boolean
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question     Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations AnswerOptionTranslation[]

  @@index([questionId])
  @@map("answer_options")
}

/// Localized content for an AnswerOption (docs/03-database/indexes.md §4).
model AnswerOptionTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  answerOptionId String   @db.Uuid
  locale         Language
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answerOption AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([answerOptionId, locale])
  @@map("answer_option_translations")
}

// ============================================================================
// Quiz configuration
// ============================================================================

/// docs/02-domain/quiz.md — optional, reusable admin-authored template.
model Quiz {
  id            String    @id @default(uuid()) @db.Uuid
  subjectId     String    @db.Uuid
  topicId       String?   @db.Uuid
  title         String
  description   String?
  mode          QuizType
  questionCount Int
  timerEnabled  Boolean
  isPublished   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Soft delete (docs/03-database/tables.md §6): set instead of removing the
  /// row so historical Quiz Sessions that reference this Quiz stay valid.
  deletedAt     DateTime?

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  quizSessions QuizSession[]

  @@index([subjectId])
  @@index([topicId])
  @@index([subjectId, isPublished])
  @@map("quizzes")
}

// ============================================================================
// Learning process (historical, immutable records)
// ============================================================================

/// docs/02-domain/quiz-session.md — immutable after completion. All content
/// references use Restrict so historical sessions can never be invalidated by
/// deleting a Subject / Topic / Quiz (docs/03-database/er-diagram.md §8).
model QuizSession {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  quizId          String?    @db.Uuid
  /// Set when this session is a student working through an assignment; null
  /// for self-study, which is exactly the product that shipped before the
  /// teacher side existed (docs/02-domain/assignment.md §7).
  assignmentId    String?    @db.Uuid
  /// Set when this session is one player's half of a duel. Two sessions of one
  /// duel share this value (docs/02-domain/duel.md).
  duelId          String?    @db.Uuid
  subjectId       String     @db.Uuid
  topicId         String?    @db.Uuid
  mode            QuizType
  timerEnabled    Boolean
  questionCount   Int
  status          QuizStatus @default(DRAFT)
  startedAt       DateTime   @default(now())
  /// Timer deadline, set at creation when timerEnabled
  /// (60s x questionCount). Null for untimed sessions. Stored, not computed
  /// (docs/04-api/quiz.md §11).
  expiresAt       DateTime?
  completedAt     DateTime?
  durationSeconds Int?
  /// A mock sitting of a joint NMT block (docs/02-domain/nmt-paper.md §8): the
  /// block's slug. Null for a sitting of one subject and for everything else.
  nmtBlock        String?
  createdAt       DateTime   @default(now())

  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz           Quiz?                 @relation(fields: [quizId], references: [id], onDelete: Restrict)
  assignment     Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  duel           Duel?                 @relation(fields: [duelId], references: [id], onDelete: Restrict)
  subject        Subject               @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic          Topic?                @relation(fields: [topicId], references: [id], onDelete: Restrict)
  questions      QuizSessionQuestion[]
  attempts       QuestionAttempt[]
  result         Result?
  xpTransactions XPTransaction[]

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([quizId])
  @@index([userId, completedAt(sort: Desc)])
  @@index([assignmentId])
  @@index([duelId])
  @@map("quiz_sessions")
}

/// The fixed question set of a session, captured at start
/// (docs/02-domain/quiz-session.md §8). Stores ids and order only — question
/// content stays in the (soft-delete-preserved) question rows.
model QuizSessionQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  quizSessionId String   @db.Uuid
  questionId    String   @db.Uuid
  position      Int
  createdAt     DateTime @default(now())

  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([quizSessionId, questionId])
  @@unique([quizSessionId, position])
  @@index([quizSessionId])
  @@map("quiz_session_questions")
}

/// docs/02-domain/question-attempt.md — immutable. questionId uses Restrict so
/// deleting a Question cannot invalidate historical attempts
/// (docs/03-database/er-diagram.md §8).
model QuestionAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  quizSessionId    String   @db.Uuid
  questionId       String   @db.Uuid
  selectedAnswer   Json?
  isCorrect        Boolean
  answeredAt       DateTime @default(now())
  timeSpentSeconds Int?
  createdAt        DateTime @default(now())

  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([quizSessionId, questionId])
  @@index([quizSessionId])
  @@index([questionId])
  @@map("question_attempts")
}

/// docs/02-domain/result.md — one immutable Result per completed QuizSession.
model Result {
  id                  String   @id @default(uuid()) @db.Uuid
  quizSessionId       String   @unique @db.Uuid
  correctAnswers      Int
  incorrectAnswers    Int
  unansweredQuestions Int
  totalQuestions      Int
  accuracy            Decimal  @db.Decimal(5, 2)
  score               Decimal  @db.Decimal(5, 2)
  completedAt         DateTime
  createdAt           DateTime @default(now())

  quizSession    QuizSession        @relation(fields: [quizSessionId], references: [id], onDelete: Cascade)
  xpTransactions XPTransaction[]
  /// Mock NMT sittings only: one score per paper sat.
  paperScores    ResultPaperScore[]

  @@map("results")
}

/// docs/02-domain/nmt-paper.md §6 — one NMT paper's score in a mock sitting,
/// by the exam's own scoring: test points out of the paper's maximum and the
/// official 100–200 score. One row for a sitting of one subject, one per
/// subject for a joint block, none for any other session.
model ResultPaperScore {
  id            String @id @default(uuid()) @db.Uuid
  resultId      String @db.Uuid
  subjectId     String @db.Uuid
  testPoints    Int
  maxTestPoints Int
  /// Null below the paper's pass threshold: the exam gives no score there.
  scaledScore   Int?

  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([resultId, subjectId])
  @@index([subjectId])
  @@map("result_paper_scores")
}

/// docs/02-domain/xp-transaction.md — immutable audit record. All references use
/// Restrict to preserve the complete progression history.
model XPTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  quizSessionId String   @db.Uuid
  resultId      String   @db.Uuid
  amount        Int
  reason        XPSource
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  quizSession QuizSession @relation(fields: [quizSessionId], references: [id], onDelete: Restrict)
  result      Result      @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([quizSessionId])
  @@index([resultId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("xp_transactions")
}

// ============================================================================
// Learning materials (Post-MVP entity, schema implemented now)
// ============================================================================

/// docs/02-domain/learning-material.md
model LearningMaterial {
  id                   String    @id @default(uuid()) @db.Uuid
  subjectId            String    @db.Uuid
  topicId              String?   @db.Uuid
  title                String
  slug                 String
  description          String?
  /// Markdown, with LaTeX between $…$ / $$…$$ (docs/02-domain/learning-material.md §7).
  content              String
  /// Derived from the word count at write time rather than authored, so it
  /// cannot drift from the text it describes.
  estimatedReadingTime Int?
  displayOrder         Int
  isPublished          Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// Soft delete (docs/03-database/tables.md §6): set instead of removing the
  /// row, so a slug stays reserved within its subject.
  deletedAt            DateTime?

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([topicId])
  @@map("learning_materials")
}

// ============================================================================
// Teacher side — groups, membership, subscription
//
// docs/02-domain/group.md, docs/02-domain/subscription.md, and the numbered
// decisions in docs/00-overview/teacher-side-decisions.md. Everything here is
// additive: a
// student who never joins a group sees exactly the product that shipped
// before it, because nothing in the existing models depends on these.
// ============================================================================

/// A teacher's class: their students, in one subject.
///
/// One subject rather than a mixed class (decision 05) so the assignment
/// builder and the group analytics read unambiguously — "64 % accuracy" across
/// four subjects means nothing. A teacher who works two subjects with the same
/// children keeps two groups.
///
/// One owner rather than co-teachers (decision 06): that is the norm for
/// private tutoring and the simplest possible permission model.
model Group {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @db.Uuid
  subjectId  String    @db.Uuid
  name       String
  /// Permanent join code, shared once in a chat rather than issued per student
  /// (decision 07). Regenerating it replaces the value, which silently retires
  /// the old one — that is the intended way to lock a group.
  inviteCode String    @unique
  /// Archive instead of delete: last year's history is what a teacher shows
  /// when deciding whether to renew.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  memberships GroupMembership[]
  assignments Assignment[]

  @@index([ownerId])
  @@index([subjectId])
  @@map("groups")
}

/// A student's membership in a group — the entity the whole permission model
/// rests on.
///
/// Leaving closes the row with `leftAt` instead of deleting it (decision 02).
/// That is what lets a teacher keep the results of work they set while the
/// student's current activity disappears the same day, and it makes every
/// access check a question about time: was this student in my group *when this
/// data was created*, not are they in it now.
///
/// The uniqueness of (group, student) therefore holds only among open
/// memberships, so a student who left can rejoin without colliding with their
/// own history. Postgres treats NULLs as distinct, so a plain `@@unique` would
/// permit several open rows; the partial index that enforces this properly is
/// added by hand in the migration.
model GroupMembership {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  studentId String    @db.Uuid
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([studentId])
  @@index([groupId, leftAt])
  @@map("group_memberships")
}

/// A teacher's subscription. One per teacher, hence the unique userId.
///
/// Exceeding a tier mid-month blocks nothing (decision 20): the lesson finishes
/// and the difference is charged from the next cycle. Non-payment never
/// punishes students — they keep taking tests, reading materials and seeing
/// their own statistics; the teacher loses new assignments and analytics.
model Subscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  tier   SubscriptionTier   @default(TIER_10)
  status SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  /// Identifiers held by the payment provider. Null while trialing, because a
  /// trial takes no card.
  providerCustomerId     String?
  providerSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

/// What a teacher was billed for in one calendar month.
///
/// The count itself is derivable — an active student is one who was set at
/// least one assignment that month (decision 03) — but the snapshot has to
/// exist: without it a teacher cannot check what they were charged for, and an
/// argument about an invoice costs more than a table.
model UsageSnapshot {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  /// First day of the calendar month the snapshot covers.
  periodStart    DateTime
  activeStudents Int
  tierAtSnapshot SubscriptionTier
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([periodStart])
  @@map("usage_snapshots")
}

// ============================================================================
// Assignments
//
// docs/02-domain/assignment.md. Two things are frozen at the moment of issue:
// which questions the assignment contains and who it was issued to. That is
// what makes an assignment a historical fact rather than a live query, and it
// is what lets a teacher keep the results of work they set after a student has
// left the group (docs/00-overview/teacher-side-decisions.md decisions 12, 27).
// ============================================================================

/// A set of questions issued to named students with a deadline.
model Assignment {
  id          String  @id @default(uuid()) @db.Uuid
  groupId     String  @db.Uuid
  createdById String  @db.Uuid
  title       String
  description String?

  /// When students may start. Null means immediately.
  openAt DateTime?
  dueAt  DateTime

  /// How many times a student may take it; one by default, because homework is
  /// control rather than practice unless the teacher says otherwise.
  attemptsAllowed Int                   @default(1)
  scoredAttempt   ScoredAttempt         @default(FIRST)
  explanations    ExplanationVisibility @default(AFTER_SUBMIT)
  /// The group subject's NMT paper instead of practice questions: one variant
  /// drawn at issue, sat on the paper's clock and scored by its table.
  mockExam        Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  questions AssignmentQuestion[]
  targets   AssignmentTarget[]
  sessions  QuizSession[]

  @@index([groupId])
  @@index([groupId, dueAt])
  @@map("assignments")
}

/// The question list, frozen at issue.
///
/// Rows reference questions rather than copying them, so a correction to a
/// title still reaches an issued assignment — but the *membership* of the set
/// never changes. Without this, two students in the same group could sit
/// different papers and their scores would not be comparable.
///
/// The cost is recorded in docs/00-overview/teacher-side-decisions.md §9: a
/// question later found to be wrong stays in assignments already issued.
model AssignmentQuestion {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  questionId   String @db.Uuid
  /// Same order for every student — a shared paper, not a shuffled one.
  order        Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, questionId])
  @@unique([assignmentId, order])
  @@index([assignmentId])
  @@map("assignment_questions")
}

/// The recipients, frozen at issue.
///
/// A student who joins the group afterwards does not receive it (decision 27):
/// the assignment stays an unchanging record of what was set, to whom, and
/// when. A live recipient list would be friendlier to the teacher and would
/// quietly break the archive rule that decision 02 rests on.
model AssignmentTarget {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  studentId    String @db.Uuid

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_targets")
}

/// Which questions a learner has already been shown, and when
/// (docs/00-overview/teacher-side-decisions.md decision 15).
///
/// Exists because a bank of roughly 41 questions per topic empties fast: a
/// ten-question test exhausts a topic in four sittings, after which practice
/// quietly turns into a memory test of those particular items. Recording what
/// has been seen is what lets selection prefer what has not.
///
/// Written for every session, whatever its kind — homework, practice, a duel.
/// "Seen" is a fact about the learner, not about the mode they saw it in.
model QuestionExposure {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  questionId String   @db.Uuid
  shownAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, shownAt])
  @@index([userId, questionId, shownAt])
  @@map("question_exposures")
}

/// What is wrong with a question, as the person who hit it sees it.
enum QuestionReportReason {
  WRONG_ANSWER
  TYPO
  UNCLEAR
  BROKEN_FORMULA
  OTHER
}

/// Where a report sits in the queue.
enum QuestionReportStatus {
  NEW
  ACCEPTED
  REJECTED
}

/// A complaint about a question, from a learner or a teacher.
///
/// Cheap to build and disproportionately useful: it is free quality control
/// over a bank of 3 308 questions, it tells a reader that somebody is
/// watching, and it is the evidence a buyer asks for when they want to know
/// whether the content has a process behind it.
///
/// One open report per person per question — the same reader hitting the same
/// bad question in three quizzes is one complaint, not three.
model QuestionReport {
  id           String               @id @default(uuid()) @db.Uuid
  questionId   String               @db.Uuid
  reportedById String               @db.Uuid
  reason       QuestionReportReason
  comment      String?
  status       QuestionReportStatus @default(NEW)

  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  /// What the reviewer decided, for the next person who opens the queue.
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedBy User     @relation("ReportAuthor", fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_reports")
}

/// A question this learner got wrong, scheduled to come back.
///
/// Spaced repetition over the mistake log the application already keeps: every
/// wrong answer is recorded anyway, so the only new thing here is *when* to
/// show it again. That makes it the cheapest serious retention feature in the
/// product — it turns "I will revise before the exam" into something that
/// happens on a Tuesday.
///
/// One row per learner and question, revived rather than duplicated: getting
/// the same question wrong a second time restarts the ladder instead of
/// opening a parallel schedule.
model MistakeReview {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  questionId String @db.Uuid

  /// Position on the ladder — 1, 3 or 7 days out. Answering correctly moves
  /// up; answering wrong drops back to the first rung.
  stage     Int       @default(1)
  dueAt     DateTime
  /// Set once the learner has answered correctly at the last rung.
  clearedAt DateTime?

  /// Kept after clearing so a learner can see what they have fixed.
  timesWrong   Int @default(1)
  timesCorrect Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, clearedAt, dueAt])
  @@map("mistake_reviews")
}

/// How the two players meet.
enum DuelMode {
  /// Both sit the same paper whenever they like; the result is a comparison.
  /// Needs no real-time anything, which is why it ships first.
  ASYNC
  /// Both on the clock together, question by question.
  LIVE
}

/// Where a duel sits in its life.
enum DuelStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  EXPIRED
}

/// A match between two learners over the same set of questions.
///
/// Challenged by name, never matched at random (docs/00-overview/
/// teacher-side-decisions.md §8). At this size a random queue would leave
/// somebody staring at a spinner, and an empty search for an opponent reads
/// worse than no button at all.
///
/// The paper is frozen when the challenge is accepted, in one order for both
/// players — otherwise the loser can always blame an easier draw.
model Duel {
  id           String @id @default(uuid()) @db.Uuid
  challengerId String @db.Uuid
  opponentId   String @db.Uuid

  subjectId String  @db.Uuid
  topicId   String? @db.Uuid

  mode          DuelMode   @default(ASYNC)
  status        DuelStatus @default(PENDING)
  questionCount Int

  /// An unanswered challenge goes stale rather than sitting in a list forever.
  expiresAt   DateTime
  acceptedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenger User    @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User    @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic      Topic?  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  questions DuelQuestion[]
  sessions  QuizSession[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, expiresAt])
  @@map("duels")
}

/// The frozen paper, in the order both players see it.
model DuelQuestion {
  id         String @id @default(uuid()) @db.Uuid
  duelId     String @db.Uuid
  questionId String @db.Uuid
  order      Int

  duel     Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([duelId, order])
  @@unique([duelId, questionId])
  @@index([duelId])
  @@map("duel_questions")
}

/// What a notification is about.
enum NotificationKind {
  ASSIGNMENT_ISSUED
  ASSIGNMENT_DUE_SOON
}

/// One notification that has already gone out.
///
/// Exists purely so nothing is sent twice. A reminder that arrives every time
/// a scheduler happens to run is not a reminder, it is spam, and the fastest
/// way to have every learner filter the product into a folder they never open.
///
/// The uniqueness of (person, kind, subject-of-the-notification) is the whole
/// mechanism: writing the row is what claims the right to send, so two workers
/// racing on the same reminder produce one email and one conflict.
model EmailDispatch {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @db.Uuid
  kind   NotificationKind
  /// What the notification is about — an assignment id, for both kinds so far.
  refId  String           @db.Uuid
  sentAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([kind, sentAt])
  @@map("email_dispatches")
}
